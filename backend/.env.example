# Database (defaults to local SQLite file if unset — swap to Postgres for production)
DATABASE_URL=sqlite:///./ai_employee_os.db
# DATABASE_URL=postgresql://user:password@localhost:5432/ai_employee_os

# OpenAI API key — used by the AI Quotation/Invoice Assistant and AI Email Assistant
# to draft line items, summaries, emails, and to classify/summarize pasted text.
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-4o-mini

# Company profile used on generated PDFs
COMPANY_NAME="Your Company Pvt Ltd"
COMPANY_ADDRESS="123 Business Street, Faisalabad, Punjab, Pakistan"
COMPANY_EMAIL="billing@yourcompany.com"
COMPANY_PHONE="+92 300 0000000"
COMPANY_TAX_ID="TAX-ID-000000"
DEFAULT_TAX_RATE=0.0
DEFAULT_CURRENCY=USD

# CORS
FRONTEND_ORIGIN=http://localhost:3000

# Auth — generate a real secret for production, e.g. `openssl rand -hex 32`
JWT_SECRET_KEY=dev-secret-change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# AI Email Assistant — SMTP for actually sending drafted emails.
# Leave SMTP_HOST empty during development: sends will be logged as "failed" with a
# clear error instead of throwing, so the rest of the app stays usable without it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=billing@yourcompany.com
SMTP_FROM_NAME="Your Company"

# Follow-up Scheduler — how often (in minutes) the background job checks for
# emails whose follow-up date has passed and drafts a nudge. Runs inside this same
# backend process; no separate worker needed. Lower this for testing (e.g. to 1),
# or trigger a check immediately via POST /api/follow-ups/check-now.
FOLLOWUP_CHECK_INTERVAL_MINUTES=60

# Recurring Invoice Scheduler — how often (in minutes) the background job checks for
# recurring invoice templates that are due to generate their next occurrence. Also
# runs inside this same backend process. Defaults to once a day (1440 minutes) since
# billing cycles don't need hourly checks; lower it for testing, or trigger
# immediately via POST /api/invoices/recurring/check-now.
RECURRING_INVOICE_CHECK_INTERVAL_MINUTES=1440

# ---------------------------------------------------------------------------
# Voice commands & Meeting Assistant
# ---------------------------------------------------------------------------

# Speech-to-text model. Uses the same OPENAI_API_KEY as everything else; without
# a key, voice and meetings return a clear "no API key configured" message rather
# than failing oddly.
WHISPER_MODEL=whisper-1

# Where voice recordings are kept so a disputed transcript can be re-listened to.
#   none  — transcribe and discard (no recording is ever stored)
#   local — write to VOICE_AUDIO_LOCAL_DIR (good for development and self-hosting)
#   s3    — S3, or any S3-compatible bucket. Cloudflare R2 is this plus
#           S3_ENDPOINT_URL; there's no separate R2 mode and there doesn't need
#           to be. Requires `pip install boto3`, which is otherwise not needed.
VOICE_AUDIO_BACKEND=local
VOICE_AUDIO_LOCAL_DIR=./var/voice-audio
VOICE_AUDIO_RETENTION_DAYS=90

S3_BUCKET=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Optional external speaker-diarization service for meetings. Whisper returns no
# speaker labels at all, so without this, meeting speakers are estimated from
# pauses and the UI says so. Any endpoint that accepts an audio file and returns
# {"segments": [{"start": 0.0, "end": 4.2, "speaker": "A"}, ...]} will work.
DIARIZATION_URL=
DIARIZATION_API_KEY=

# Conditional follow-up sweep — "remind me if they don't reply in three days".
# Checks each follow-up's condition when its deadline arrives and only then
# creates a reminder task. Runs in this same backend process; trigger it
# immediately with POST /api/tasks/followups/check-now.
VOICE_FOLLOWUP_CHECK_INTERVAL_MINUTES=30

# Audio retention sweep — deletes recordings past VOICE_AUDIO_RETENTION_DAYS and
# gives the storage quota back. Retention is measured in months, so twice a day
# is plenty.
VOICE_AUDIO_SWEEP_INTERVAL_MINUTES=720

# ---------------------------------------------------------------------------
# Knowledge base — OCR for scanned PDFs
# ---------------------------------------------------------------------------

# Whether to OCR PDF pages that have no text layer (scanned contracts,
# faxed/photographed pages) instead of just rejecting the upload. Needs the
# `tesseract-ocr` system binary in addition to the pip packages in
# requirements.txt — pip alone is not enough:
#   Ubuntu/Debian: sudo apt-get install tesseract-ocr
#   macOS:         brew install tesseract
# If the binary isn't found, OCR is skipped and the old behaviour (an error
# naming the PDF as likely-scanned) applies — nothing crashes either way.
OCR_ENABLED=true
OCR_LANGUAGE=eng
OCR_MAX_PAGES=60
